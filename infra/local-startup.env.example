# Example only. Existing users keep their working root .env unchanged.
# New installations: copy this file to the repository root as .env,
# replace the placeholder password privately, and keep .env out of Git.
POSTGRES_DB=bugtrace
POSTGRES_USER=bugtrace_dev
POSTGRES_PASSWORD=replace_with_your_own_local_password
DB_URL=jdbc:postgresql://127.0.0.1:5432/bugtrace

# Plumbing mode. Mock results are not model-performance measurements.
BUGTRACE_AI_PROVIDER=mock
BUGTRACE_AI_MODEL=mock-v1

# Personal and worker access keys belong in Password Safe / hidden prompts.
# Do not put them in this example or in reports.
